[
  {
    "label": "Fullscreen Terminal",
    "command": "tmux new-session -A -s \"$(basename \"$PWD\")\"",
    "hide": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": true
  },
  {
    "label": "Television File Finder",
    "command": "zed \"$(tv files)\"",
    "hide": "always",
    "allow_concurrent_runs": true,
    "use_new_terminal": true
  },
  {
    "label": "Lazygit",
    "command": "lazygit",
    "hide": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": true
  },
  {
    "label": "Television Git Repos",
    "command": "zed \"$(tv git-repos ~/Documents)\"",
    "hide": "always",
    "allow_concurrent_runs": true,
    "use_new_terminal": true
  },
  {
    "label": "Television Text Search",
    "command": "zed \"$(tv text \"$ZED_WORKTREE_ROOT\")\"",
    "hide": "always",
    "allow_concurrent_runs": true,
    "use_new_terminal": true
  },
  {
    "label": "Television Kill Process",
    "command": "kill -9 $(tv procs)",
    "hide": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": true
  }
]
