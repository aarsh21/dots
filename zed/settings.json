{
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "autosave": "on_focus_change",
  "relative_line_numbers": "enabled",
  "toolbar": {
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "minimap": {
    "thumb_border": "none"
  },
  "scrollbar": {
    "show": "never"
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5"
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.5"
    },
    "dock": "right",
    "model_parameters": []
  },
  "collaboration_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "git_panel": {
    "scrollbar": {
      "show": "auto"
    },
    "dock": "bottom",
    "button": false
  },
  "outline_panel": {
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "button": false
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_branch_name": false,
    "show_project_items": false,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_branch_icon": false
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "terminal": {
    "button": false,
    "shell": {
      "with_arguments": {
        "program": "/bin/bash",
        "args": ["-c", "tmux new-session -A -s \"$(basename \"$PWD\")\""]
      }
    }
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": false
  },
  "project_panel": {
    "hide_gitignore": true,
    "default_width": 300.0,
    "dock": "left"
  },
  "use_smartcase_search": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "cursor_shape": "bar",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "vim_mode": true,
  "base_keymap": "Cursor",
  "agent_ui_font_size": 16.0,
  "agent_buffer_font_size": 14.0,
  "ui_font_size": 18.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "Vesper",
    "dark": "Kanagawa Dragon"
  }
}
