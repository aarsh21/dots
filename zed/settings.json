// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "context7_api_key": "ctx7sk-250b3e86-9b88-4e01-a525-1576132348ed"
      }
    }
  },
  "relative_line_numbers": "enabled",
  "toolbar": {
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "minimap": {
    "thumb_border": "none"
  },
  "scrollbar": {
    "show": "never"
  },
  "agent": {
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.5"
    },
    "play_sound_when_agent_done": true,
    "dock": "left",
    "model_parameters": []
  },
  "collaboration_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "git_panel": {
    "scrollbar": {
      "show": "auto"
    },
    "dock": "bottom",
    "button": false
  },
  "outline_panel": {
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "button": false
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_branch_name": false,
    "show_project_items": false,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_branch_icon": false
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "terminal": {
    "button": false
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": false
  },
  "project_panel": {
    "scrollbar": {
      "show": "never"
    },
    "dock": "right",
    "button": false
  },
  "use_smartcase_search": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "cursor_shape": "bar",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "vim_mode": true,
  "base_keymap": "Cursor",
  "agent_ui_font_size": 16.0,
  "agent_buffer_font_size": 14.0,
  "ui_font_size": 18.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "Vesper",
    "dark": "Vesper"
  }
}
